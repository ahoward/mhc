---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "an engineering collective, owned by the people who do the work." } = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:image" content={new URL("/favicon.png", Astro.site)} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
  <link rel="alternate icon" href="/favicon.ico" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Overpass+Mono:wght@400;600;700&display=swap" />

  <style is:global>
    :root {
      --fireweed: #C81E6E;
      --glacier:  #1A9CB5;
      --sun:      #D99209;
      --aurora:   #00FF88;
      --taiga:    #2F4A2F;
      --tundra:   #6B4A2B;
      --snow:     #FAFAF7;
      --basalt:   #1C1C1E;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      background: var(--snow);
      color: var(--basalt);
      font-family: 'Overpass Mono', Menlo, Monaco, monospace;
      font-size: 16px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    main {
      max-width: 42rem;
      margin: 0 auto;
      padding: 4rem 1.5rem 6rem;
    }

    .wordmark {
      font-weight: 700;
      font-size: clamp(3rem, 12vw, 7rem);
      letter-spacing: -0.02em;
      line-height: 1;
      margin: 0 0 3rem;
      white-space: nowrap;
    }
    .wordmark a { color: inherit; border: 0; }
    .wordmark .m { color: var(--fireweed); }
    .wordmark .t { color: var(--glacier); }
    .wordmark .n { color: var(--sun); }

    p { margin: 0 0 1.4rem; }
    img { max-width: 100%; height: auto; display: block; margin: 0 0 1.4rem; }

    a {
      color: var(--glacier);
      text-decoration: none;
      border-bottom: 1px solid currentColor;
    }
    a:hover, a:focus { color: var(--fireweed); }

    .vcevil { color: var(--fireweed); }

    /* small caps label under the wordmark */
    .eyebrow {
      margin: -2.2rem 0 2.4rem;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--tundra);
    }

    /* pedigree list with a fireweed left rule */
    .spec {
      margin: 0 0 1.4rem;
      padding: 0.2rem 0 0.2rem 1.1rem;
      border-left: 2px solid var(--fireweed);
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
    }
    .spec span { display: block; font-size: 0.95em; }

    strong { color: var(--fireweed); font-weight: 700; }

    /* closing line */
    .creed {
      margin: 2.4rem 0 0;
      font-weight: 700;
      letter-spacing: 0.04em;
      color: var(--glacier);
    }

    .contact { margin-top: 2rem; font-size: 1.1em; }
  </style>
</head>

<body>
  <main>
    <h1 class="wordmark"><a href="/"><span class="m">m</span><span class="t">t</span><span class="n">&#x207F;</span></a></h1>
    <slot />
  </main>
</body>
</html>
